<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- AdminDashboard.fxml: the screen where the admin adds timetable entries. Its controller is AdminDashboardController. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.school.oop.ui.AdminDashboardController">

    <!-- TOP: the blue header. -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="2">
                <Label text="STRATHMORE UNIVERSITY" styleClass="header-title"/>
                <Label text="Admin Dashboard" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="4">
                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="Welcome," styleClass="header-welcome"/>
                    <Label text="Stratizen" styleClass="header-welcome-name"/>
                </HBox>
                <Label fx:id="roleLabel" styleClass="header-role"/>
            </VBox>
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- CENTER: the form on top and the table of all entries below it. -->
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="16" right="24" bottom="12" left="24"/>
            </padding>

            <!-- The form. Each input becomes one column of the new row in MySQL. -->
            <VBox styleClass="card" spacing="12">
                <Label text="Add a timetable entry" styleClass="panel-title"/>
                <HBox spacing="14">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Class group" styleClass="field-label"/>
                        <TextField fx:id="classGroupField" promptText="e.g. BICS 1A"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Course name" styleClass="field-label"/>
                        <TextField fx:id="courseNameField" promptText="e.g. Object Oriented Programming I"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Lecturer name" styleClass="field-label"/>
                        <TextField fx:id="lecturerNameField" promptText="e.g. Dr N Ochieng"/>
                    </VBox>
                </HBox>
                <HBox spacing="14" alignment="BOTTOM_LEFT">
                    <VBox spacing="5">
                        <Label text="Day of the week" styleClass="field-label"/>
                        <ComboBox fx:id="dayCombo" prefWidth="150"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Time slot: starts at" styleClass="field-label"/>
                        <ComboBox fx:id="startTimeCombo" prefWidth="120"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Time slot: ends at" styleClass="field-label"/>
                        <ComboBox fx:id="endTimeCombo" prefWidth="120"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Room" styleClass="field-label"/>
                        <ComboBox fx:id="roomCombo" prefWidth="170"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Add Entry" onAction="#handleAddEntry" styleClass="primary-button"/>
                    <Button text="Clear Form" onAction="#handleClearForm" styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <!-- The table of timetable entries, with a filter to show only one class group. -->
            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="2">
                        <Label text="Timetable entries" styleClass="panel-title"/>
                        <Label text="Bookings made by lecturers and class reps have the class group &quot;Booking&quot;."
                               styleClass="hint-label"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="5">
                        <Label text="Filter by class group" styleClass="field-label"/>
                        <ComboBox fx:id="filterCombo" onAction="#handleFilterChanged" prefWidth="190"/>
                    </VBox>
                    <Button text="Delete Selected" onAction="#handleDeleteEntry" styleClass="danger-button"/>
                </HBox>
                <TableView fx:id="timetableTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="The timetable is empty"/>
                    </placeholder>
                    <columns>
                        <TableColumn text="Class Group" prefWidth="110">
                            <cellValueFactory>
                                <PropertyValueFactory property="classGroup"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Course" prefWidth="250">
                            <cellValueFactory>
                                <PropertyValueFactory property="courseName"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Lecturer" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="lecturerName"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Day" prefWidth="110">
                            <cellValueFactory>
                                <PropertyValueFactory property="dayOfWeek"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Time Slot" prefWidth="140">
                            <cellValueFactory>
                                <PropertyValueFactory property="timeSlot"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Room" prefWidth="130">
                            <cellValueFactory>
                                <PropertyValueFactory property="room"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- BOTTOM: a line of text for messages. -->
    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </bottom>
</BorderPane>
