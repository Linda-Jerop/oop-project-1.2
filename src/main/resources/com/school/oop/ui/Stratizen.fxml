<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Stratizen.fxml: the screen for lecturers, class reps and students. Its controller is StratizenController. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.school.oop.ui.StratizenController">

    <!-- TOP: the blue header with the welcome message and the Logout button. -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="2">
                <Label text="STRATHMORE UNIVERSITY" styleClass="header-title"/>
                <Label text="Room Finder" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="4">
                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="Welcome," styleClass="header-welcome"/>
                    <Label text="Stratizen" styleClass="header-welcome-name"/>
                </HBox>
                <Label fx:id="roleLabel" styleClass="header-role"/>
            </VBox>
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- CENTER: two tabs. Students see only the first one. There is no timetable tab, only the admin sees timetables. -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

            <!-- TAB 1: search for rooms (and book one if the role allows it). -->
            <Tab text="Find a Room">
                <VBox spacing="14">
                    <padding>
                        <Insets top="16" right="24" bottom="12" left="24"/>
                    </padding>

                    <!-- The five search inputs and the buttons. A FlowPane puts them on one line and wraps when the window is narrow. -->
                    <VBox styleClass="card">
                        <FlowPane hgap="14" vgap="10" rowValignment="BOTTOM">
                            <VBox spacing="5">
                                <Label text="Day of the week" styleClass="field-label"/>
                                <ComboBox fx:id="dayCombo" prefWidth="150"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Time (24 hour)" styleClass="field-label"/>
                                <TextField fx:id="timeField" promptText="e.g. 10:15" prefWidth="110"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Type of building" styleClass="field-label"/>
                                <ComboBox fx:id="buildingCombo" prefWidth="180"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Minimum capacity" styleClass="field-label"/>
                                <TextField fx:id="capacityField" promptText="e.g. 40" prefWidth="130"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Type of room" styleClass="field-label"/>
                                <ComboBox fx:id="roomTypeCombo" prefWidth="140"/>
                            </VBox>
                            <HBox spacing="10">
                                <Button text="Search" onAction="#handleSearch" styleClass="primary-button" defaultButton="true"/>
                                <Button text="Use now" onAction="#handleUseNow" styleClass="secondary-button"/>
                            </HBox>
                        </FlowPane>
                    </VBox>

                    <!-- The table of rooms. Each column reads one getter of the Room class, for example roomName -> getRoomName(). -->
                    <VBox styleClass="card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="roomTable" onMouseClicked="#handleRoomClicked" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No rooms match your search"/>
                            </placeholder>
                            <columns>
                                <TableColumn text="Room" prefWidth="140">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="roomName"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Building" prefWidth="170">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="building"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Capacity" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="capacity"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Type" prefWidth="120">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="roomType"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="130">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="status"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="bookingColumn" text="Booking" prefWidth="120">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="bookingAction"/>
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- The booking form. The controller hides it from students. -->
                    <VBox fx:id="bookingPanel" styleClass="card" spacing="8">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Book a room" styleClass="panel-title"/>
                            <Label fx:id="selectedRoomLabel" text="Click a vacant room in the table to select it."
                                   styleClass="selected-room"/>
                        </HBox>
                        <HBox spacing="14" alignment="BOTTOM_LEFT">
                            <VBox spacing="5">
                                <Label text="End time" styleClass="field-label"/>
                                <ComboBox fx:id="endTimeCombo" prefWidth="120"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Event or purpose" styleClass="field-label"/>
                                <TextField fx:id="purposeField" promptText="e.g. Mentoring session"/>
                            </VBox>
                            <Button text="Book Selected Room" onAction="#handleBookRoom" styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 2: the rooms this user has booked, with a button to delete one. The controller removes this tab for students. -->
            <Tab fx:id="myBookingsTab" text="My Bookings">
                <VBox spacing="14">
                    <padding>
                        <Insets top="16" right="24" bottom="12" left="24"/>
                    </padding>

                    <HBox styleClass="card" alignment="CENTER_LEFT" spacing="14">
                        <VBox spacing="2">
                            <Label text="My bookings" styleClass="panel-title"/>
                            <Label text="Click one of your bookings to change it or delete it."
                                   styleClass="selected-room"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete Booking" onAction="#handleDeleteBooking" styleClass="danger-button"/>
                    </HBox>

                    <VBox styleClass="card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="bookingsTable" onMouseClicked="#handleBookingSelected" onKeyReleased="#handleBookingSelected"
                                   VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="You have not booked any room yet"/>
                            </placeholder>
                            <columns>
                                <TableColumn text="Event or Purpose" prefWidth="300">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="courseName"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Day" prefWidth="130">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="dayOfWeek"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Time Slot" prefWidth="160">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="timeSlot"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Room" prefWidth="150">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="room"/>
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- The form to change the selected booking. The room stays the same, the day, times and purpose can change. -->
                    <VBox styleClass="card" spacing="8">
                        <Label text="Change the selected booking" styleClass="panel-title"/>
                        <FlowPane hgap="14" vgap="10" rowValignment="BOTTOM">
                            <VBox spacing="5">
                                <Label text="Day of the week" styleClass="field-label"/>
                                <ComboBox fx:id="editDayCombo" prefWidth="150"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Start time" styleClass="field-label"/>
                                <ComboBox fx:id="editStartCombo" prefWidth="110"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="End time" styleClass="field-label"/>
                                <ComboBox fx:id="editEndCombo" prefWidth="110"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Event or purpose" styleClass="field-label"/>
                                <TextField fx:id="editPurposeField" prefWidth="320"/>
                            </VBox>
                            <Button text="Update Booking" onAction="#handleUpdateBooking" styleClass="primary-button"/>
                        </FlowPane>
                    </VBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- BOTTOM: a line of text for messages. -->
    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </bottom>
</BorderPane>
